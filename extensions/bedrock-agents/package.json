{
	"name": "bedrock-agents",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.0.1",
	"publisher": "vscode",
	"license": "MIT",
	"engines": {
		"vscode": "^1.0.0"
	},
	"enabledApiProposals": [
		"chatProvider",
		"languageModelThinkingPart"
	],
	"activationEvents": [
		"onLanguageModelChatProvider:bedrock"
	],
	"main": "./out/extension",
	"scripts": {
		"compile": "gulp compile-extension:bedrock-agents",
		"watch": "gulp watch-extension:bedrock-agents"
	},
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "bedrock",
				"displayName": "%providerDisplayName%",
				"configuration": {
					"type": "object",
					"properties": {
						"region": {
							"type": "string",
							"title": "%configRegionTitle%",
							"description": "%configRegionDescription%"
						},
						"profile": {
							"type": "string",
							"title": "%configProfileTitle%",
							"description": "%configProfileDescription%"
						},
						"accessKeyId": {
							"type": "string",
							"secret": true,
							"title": "%configAccessKeyIdTitle%",
							"description": "%configAccessKeyIdDescription%"
						},
						"secretAccessKey": {
							"type": "string",
							"secret": true,
							"title": "%configSecretAccessKeyTitle%",
							"description": "%configSecretAccessKeyDescription%"
						},
						"sessionToken": {
							"type": "string",
							"secret": true,
							"title": "%configSessionTokenTitle%",
							"description": "%configSessionTokenDescription%"
						}
					}
				}
			}
		],
		"configuration": {
			"title": "%configurationTitle%",
			"properties": {
				"bedrockAgents.agentFiles": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						".vscode/bedrock-agents/*.json"
					],
					"markdownDescription": "%agentFilesDescription%",
					"scope": "machine-overridable"
				}
			}
		}
	},
	"dependencies": {
		"@aws-sdk/client-bedrock-runtime": "^3.1136.0",
		"@aws-sdk/credential-providers": "^3.1136.0",
		"jsonc-parser": "^3.3.1"
	},
	"devDependencies": {
		"@types/node": "24.x"
	}
}
